{
  "name": "abl-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "A model-agnostic MCP server for governed ABL and loan-tape analytics.",
  "type": "module",
  "bin": {
    "abl-mcp": "dist/cli.js",
    "abl-operator": "dist/operator/main.js",
    "abl-mcp-remote": "dist/remote-cli.js"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx src/cli.ts",
    "operator": "node dist/operator/main.js",
    "start": "node dist/cli.js",
    "start:remote": "node dist/remote-cli.js",
    "test": "tsx --test tests/**/*.test.ts",
    "verify": "pnpm run check && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "jose": "6.2.8",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
