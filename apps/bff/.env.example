BFF_AUTH_MODE=fixture
BFF_PORT=4300
BFF_CONSOLE_URL=http://127.0.0.1:4173
BFF_ALLOWED_ORIGINS=http://127.0.0.1:4173
BFF_SECURE_COOKIES=false
BFF_OIDC_TRANSACTION_TTL_MS=600000
BFF_OIDC_TRANSACTION_MAX_ENTRIES=4096
BFF_OIDC_LOGIN_WINDOW_MS=60000
BFF_OIDC_LOGIN_MAX_ATTEMPTS=20
BFF_OIDC_LOGIN_MAX_KEYS=10000

# Required when BFF_AUTH_MODE=oidc. Use an OIDC public client with Authorization Code + PKCE.
# OIDC_ISSUER=https://identity.example.com/
# OIDC_CLIENT_ID=abl-risk-console
# OIDC_REDIRECT_URI=https://risk.example.com/api/auth/callback
# OIDC_SCOPES=openid profile email roles
