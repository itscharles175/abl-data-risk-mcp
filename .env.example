# Path to the server's non-secret JSON configuration.
ABL_MCP_CONFIG=./config/example.json

# Connection strings are referenced by name from the JSON configuration.
# Never put a database password in the JSON file or an MCP tool argument.
ABL_PORTFOLIO_DATABASE_URL=postgresql://readonly_user:replace_me@127.0.0.1:5432/portfolio

# Local HTTP transport defaults to 127.0.0.1:3333. Production HTTP must sit
# behind an OAuth/OIDC-aware gateway and must not expose this development bind.
ABL_MCP_HOST=127.0.0.1
ABL_MCP_PORT=3333
